{
 "_doc": "MASTER list of measurements and quantity modifiers, shared across domains, with per-domain overrides. Purpose: stop measurement words colliding with their literal meaning. sense_weight = ordered likelihood class (high > medium > low) that the word is used as a MEASUREMENT/AMOUNT rather than literally. All weights are hand-set priors (weight_source = assumed_prior); none are calibrated. Context rules (below, in order) override the weight.",
 "weight_source": "assumed_prior",
 "classes": [
  "high",
  "medium",
  "low"
 ],
 "context_rules": [
  {
   "rule_id": "MEAS-WORTH",
   "pattern": "X's worth | a X worth | N X worth",
   "effect": "ALWAYS amount (overrides everything)"
  },
  {
   "rule_id": "MEAS-NUM-BEFORE",
   "pattern": "number/number-word (or 'a'/'an' for approx kinds) before the word",
   "effect": "measurement"
  },
  {
   "rule_id": "MEAS-A-X-OF",
   "pattern": "after 'with': 'a X of N' ('with a clove of garlic')",
   "effect": "measurement (N is a co-object)"
  },
  {
   "rule_id": "MEAS-WITH-TOOL",
   "pattern": "word is the object of 'with'/'using' and has no number before it",
   "effect": "literal (tool), even if weight is high"
  },
  {
   "rule_id": "MEAS-DEFINITE-REFERENCE",
   "pattern": "definite determiner or possessive before the word ('the foot of the board', 'the stitches')",
   "effect": "literal"
  },
  {
   "rule_id": "MEAS-WEIGHT",
   "pattern": "no rule fired",
   "effect": "measurement iff sense_weight (after domain override) is high"
  }
 ],
